{
  "name": "hono-ddd-starter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter api --filter web --parallel dev",
    "dev:api": "bun run --filter api dev",
    "dev:web": "bun run --filter web dev",
    "build": "bun run build:api && bun run build:web",
    "build:api": "bun run --filter api build",
    "build:web": "bun run --filter web build",
    "clean:build": "rm -rf .next apps/web/.next apps/api/.next packages/domain/.next packages/frontend/.next packages/shared/.next packages/ui/.next",
    "clean:deps": "rm -rf node_modules apps/api/node_modules apps/web/node_modules packages/domain/node_modules packages/frontend/node_modules packages/shared/node_modules packages/ui/node_modules",
    "clean": "bun run clean:build && bun run clean:deps",
    "reset": "bun run clean && bun install",
    "seed:admin": "bun run --filter api seed:admin",
    "start": "bun run --filter api start",
    "start:api": "bun run --filter api start",
    "start:web": "bun run --filter web start",
    "start:all": "bun run --filter api --filter web --parallel start",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "check": "biome check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "bson": "6",
    "dotenv": "^17.4.2",
    "hono": "^4.12.26",
    "jose": "^6.2.3",
    "mongoose": "8",
    "redis": "^6.0.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "typescript": "5.9"
  }
}
