# ---- Database ----
# MongoDB connection string (replica set required for transactions)
MONGO_URI=mongodb://root:password@127.0.0.1:27017/school?replicaSet=rs0&authSource=admin

# ---- Auth ----
# Secret used to sign JWTs (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-long-random-secret

# ---- Supabase (optional) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# ---- Image storage ----
# Provider: cloudinary
IMAGE_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=school
CLOUDINARY_SECURE=true

# ---- Cache / rate limiting (optional) ----
REDIS_URL=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- First admin bootstrap (optional) ----
ADMIN_FIRST_NAME=SchoolAdmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-strong-Password-1
